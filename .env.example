# ======================================================
# Cleaning Supervision Platform - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ======================================================

# ── Node Environment ─────────────────────────────────
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=cs_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cleaning_supervision

# ── Redis ────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ──────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_STRING_DIFFERENT

# ── MinIO / S3 Storage ───────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=cleaning-supervision

# ── Encryption ───────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000

# ── Firebase (Push Notifications) ───────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── AI Service ───────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
AI_CONFIDENCE_THRESHOLD=0.75

# ── RGPD Settings ────────────────────────────────────
MEDIA_RETENTION_DAYS_MIN=7
MEDIA_RETENTION_DAYS_MAX=30
CONSENT_VERSION=1.0
DPO_EMAIL=dpo@yourcompany.com
