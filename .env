# ======================================================
# Cleaning Supervision Platform - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ======================================================

# ── Node Environment ─────────────────────────────────
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=cs_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cleaning_supervision

# ── Redis ────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ──────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=920e89fc92831880761a979176f0a3c3c0c5c5dffc84587a07b163f1386f6af5ab1a4dad3707c5ec1e8a73b1f46b162cb884c4bec9922c6106c57ad9f8a37b6a
JWT_REFRESH_SECRET=74bd7621adcee8961f94a2095d7808f0e3759d328f676eb279c3847215d97ce0714cd2fcfc88b2d282d0CcijrCfZBuqDzBWp3qSrBEZCqBUfQVz4CWGHWF91iaEw

# ── MinIO / S3 Storage ───────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=cleaning-supervision

# ── Encryption ───────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000

# ── Firebase (Push Notifications) ───────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── AI Service ───────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
AI_CONFIDENCE_THRESHOLD=0.75

# ── RGPD Settings ────────────────────────────────────
MEDIA_RETENTION_DAYS_MIN=7
MEDIA_RETENTION_DAYS_MAX=30
CONSENT_VERSION=1.0
DPO_EMAIL=dpo@yourcompany.com
